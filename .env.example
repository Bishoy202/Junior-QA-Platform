# Copy to .env and fill in. Never commit the real .env file.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ADZUNA_LOCATION=

JOOBLE_API_KEY=
# Jooble issues one API key per country domain. This project defaults to
# Egypt's regional endpoint (eg.jooble.org) -- register your key there,
# not at jooble.org (which only returns US listings).
JOOBLE_ENDPOINT=https://eg.jooble.org/api
JOOBLE_LOCATION=Egypt

USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com
USAJOBS_LOCATION=

REMOTIVE_CATEGORY=software-dev
REMOTIVE_ENDPOINT=https://remotive.com/api/remote-jobs

REMOTEOK_ENDPOINT=https://remoteok.com/api
ARBEITNOW_ENDPOINT=https://www.arbeitnow.com/api/job-board-api
REED_API_KEY=
REED_ENDPOINT=https://www.reed.co.uk/api/1.0/search
JSEARCH_RAPIDAPI_KEY=
JSEARCH_ENDPOINT=https://jsearch.p.rapidapi.com/search
SERPAPI_API_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json
# JobsPipe/LoopCV accounts expose different endpoints; configure the one provided by your account.
JOBSPIPE_ENDPOINT=
JOBSPIPE_API_KEY=
LOOPCV_ENDPOINT=
LOOPCV_API_KEY=

JOB_QUERY=junior QA tester quality assurance software testing
# Railway Volume-friendly SQLite configuration. DATA_DIR should be the Volume mount path.
DATA_DIR=/data
# Optional SQLite URL; when set, it takes precedence over DATA_DIR and DB_PATH.
# DATABASE_URL=sqlite:////data/jobs.db
# DB_PATH is a local/legacy override used only when DATABASE_URL is not set.
DB_PATH=
